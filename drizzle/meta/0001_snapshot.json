      "checkConstraints": {
        "valid_stage": {
          "name": "valid_stage",
          "value": "\"opportunities\".\"project_stage\" IN (0,20,40,60,80,90,100)"
        },
        "valid_commitment": {
          "name": "valid_commitment",
          "value": "\"opportunities\".\"performance_commitment\" IN ('力争','确保','冲刺')"
        },
        "valid_amount": {
          "name": "valid_amount",
          "value": "\"opportunities\".\"project_amount_cents\">0"
        },
        "valid_tender": {
          "name": "valid_tender",
          "value": "\"opportunities\".\"requires_tender\" IN (0,1)"
        },
        "valid_profit": {
          "name": "valid_profit",
          "value": "\"opportunities\".\"expected_profit_cents\"<=\"opportunities\".\"expected_gross_profit_cents\" AND \"opportunities\".\"expected_gross_profit_cents\"<=\"opportunities\".\"project_amount_cents\""
        },
        "valid_dates": {
          "name": "valid_dates",
          "value": "\"opportunities\".\"expected_close_date\">=\"opportunities\".\"created_date\""
        },
        "valid_bid": {
          "name": "valid_bid",
          "value": "\"opportunities\".\"requires_tender\"=1 OR (\"opportunities\".\"expected_publish_date\" IS NULL AND \"opportunities\".\"bid_award_date\" IS NULL)"
        }
      }
